# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the blanks. The values below are safe
# defaults that work with the bundled docker-compose MySQL.
# ---------------------------------------------------------------------------

# ---- Database (must match docker-compose.yml) ----
DB_HOST=127.0.0.1
# If you already run MySQL on 3306, set this to a free port (e.g. 3307) — it is
# used both for the container's host mapping and for the API connection.
DB_PORT=3306
DB_NAME=wedding_planner
DB_USER=wedding
DB_PASSWORD=weddingpass
DB_ROOT_PASSWORD=rootpass

# ---- API server ----
PORT=4000
# Long random string. Generate one, e.g.:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=change-me-to-a-long-random-string
# NOTE: do not put NODE_ENV in this file — Vite loads it and would force a dev
# build. For production set it in the shell: NODE_ENV=production npm run start:api
# (that also flips the session cookie to Secure).

# ---- Google sign-in ----
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origin:  http://localhost:5173
# The SAME client id goes in both variables below.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ---- Frontend ----
# Where the browser reaches the API. Leave blank in dev (Vite proxies /api).
VITE_API_BASE=
